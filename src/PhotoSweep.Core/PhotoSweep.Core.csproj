<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain logic: scanning, hashing, grouping, review folder + undo. No UI. The one OS-specific API is the
       MoveFileExW P/Invoke in Cleanup/NoCopyMove.cs, guarded by OperatingSystem.IsWindows(). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- [LibraryImport] generates the P/Invoke marshalling code at build time, and that code uses pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to exactly 3.1.x: 4.x needs a Six Labors licence key. See CLAUDE.md. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="[3.1.12]" />
  </ItemGroup>

</Project>
