<Window x:Class="PhotoSweep.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoSweep.Presentation;assembly=PhotoSweep.Presentation"
        xmlns:views="clr-namespace:PhotoSweep.Desktop.Views"
        Title="PhotoSweep" Width="900" Height="640" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/PhotoSweep.ico">
    <Window.Resources>
        <!-- One template per page view-model type: whatever CurrentPage holds, WPF shows the matching view. -->
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
            <views:StartView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanningViewModel}">
            <views:ScanningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
</Window>
