<UserControl x:Class="PhotoSweep.Desktop.Views.ScanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Placeholder until Phase 8 builds the real scanning page. -->
    <DockPanel Margin="24">
        <Button DockPanel.Dock="Bottom" Content="Back" Command="{Binding BackCommand}"
                HorizontalAlignment="Left" Padding="16,4" Margin="0,16,0,0" />
        <StackPanel>
            <TextBlock Text="Scanning…" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0">
                <Run Text="Strictness:" />
                <Run Text="{Binding LevelTitle, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Folders:" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Folders}" Margin="12,4,0,0" />
        </StackPanel>
    </DockPanel>
</UserControl>
