<Window x:Class="PhotoSweep.Desktop.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoSweep.Presentation;assembly=PhotoSweep.Presentation"
        xmlns:behaviors="clr-namespace:PhotoSweep.Desktop.Behaviors"
        Title="Compare photos · PhotoSweep" Width="1200" Height="840" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Icon="/Assets/PhotoSweep.ico">
    <!--
        Keys go to the window: every button and scroll area below is Focusable="False", so Space always toggles the right
        photo instead of pressing whichever button was clicked last, and the arrows never scroll a pane.
    -->
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding PreviousPhotoCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextPhotoCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousGroupCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextGroupCommand}" />
        <KeyBinding Key="Space" Command="{Binding Right.ToggleCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <SolidColorBrush x:Key="SelectedBrush" Color="#C62828" />
        <SolidColorBrush x:Key="KeeperBrush" Color="#B8860B" />
        <SolidColorBrush x:Key="BetterBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="DiffersBackground" Color="#FFF3C4" />

        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="16" />
        </Style>

        <!-- One side: heading, picture (fitted, or actual size in a scroll area), selection and buttons. -->
        <DataTemplate x:Key="PaneTemplate" DataType="{x:Type vm:ComparePaneViewModel}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Border DockPanel.Dock="Right" Background="{StaticResource SelectedBrush}" CornerRadius="3" Padding="8,2"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✓ Move" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="Heading" Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Show in folder" Command="{Binding ShowInFolderCommand}"
                            ToolTip="Opens Explorer with this file selected." />
                    <Button x:Name="Toggle" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                            ToolTip="{Binding ToggleHint}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock x:Name="SelectionText" Text="{Binding SelectionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <Border x:Name="Frame" BorderThickness="3" BorderBrush="#DDDDDD" Background="#F0F0F0" CornerRadius="3">
                    <Grid behaviors:PaneSize.Target="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" ClipToBounds="True">
                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsActualSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding DataContext.IsActualSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                      behaviors:SyncedZoomPan.Zoom="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}"
                                      behaviors:SyncedZoomPan.PanX="{Binding DataContext.PanX, RelativeSource={RelativeSource AncestorType=Window}}"
                                      behaviors:SyncedZoomPan.PanY="{Binding DataContext.PanY, RelativeSource={RelativeSource AncestorType=Window}}"
                                      behaviors:SyncedZoomPan.ZoomInCommand="{Binding DataContext.ZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      behaviors:SyncedZoomPan.ZoomOutCommand="{Binding DataContext.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Image Source="{Binding Image}" Stretch="None" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowCloudPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="56"
                                       HorizontalAlignment="Center" Foreground="#4A7FC1" />
                            <TextBlock Style="{StaticResource Placeholder}" Margin="16,8,16,0"
                                       Text="Only in the cloud. PhotoSweep doesn't download photos to show a preview." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Placeholder}"
                                   Text="File not found. It was moved or deleted since the scan, or can't be read."
                                   Visibility="{Binding ShowUnavailablePlaceholder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Placeholder}" Text="No preview: this format can't be shown, or the file is damaged."
                                   Visibility="{Binding ShowNoPreviewPlaceholder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Placeholder}" Text="Loading…"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLeft}" Value="True">
                    <Setter TargetName="Heading" Property="Foreground" Value="{StaticResource KeeperBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
                    <Setter TargetName="SelectionText" Property="Foreground" Value="{StaticResource SelectedBrush}" />
                    <Setter TargetName="SelectionText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            A detail row under one photo. Highlighted when the two photos differ; "✓ Better" on the side the keeper
            ranking prefers for this detail. Two templates only because one shows Left and the other Right.
        -->
        <Style x:Key="DetailRow" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Differs}" Value="True">
                    <Setter Property="Background" Value="{StaticResource DiffersBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="LeftDetail" DataType="{x:Type vm:CompareDetailRow}">
            <Border Style="{StaticResource DetailRow}">
                <DockPanel>
                    <TextBlock Text="{Binding Label}" Width="96" Foreground="Gray" />
                    <TextBlock DockPanel.Dock="Right" Text="✓ Better" Foreground="{StaticResource BetterBrush}" FontWeight="SemiBold" Margin="8,0,0,0"
                               Visibility="{Binding LeftBetter, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Left}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Left}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RightDetail" DataType="{x:Type vm:CompareDetailRow}">
            <Border Style="{StaticResource DetailRow}">
                <DockPanel>
                    <TextBlock Text="{Binding Label}" Width="96" Foreground="Gray" />
                    <TextBlock DockPanel.Dock="Right" Text="✓ Better" Foreground="{StaticResource BetterBrush}" FontWeight="SemiBold" Margin="8,0,0,0"
                               Visibility="{Binding RightBetter, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Right}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Right}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16,12,16,12">
        <!-- Navigation and view options -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsActualSize, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (−, or Ctrl+wheel)" MinWidth="28" />
                    <TextBlock Text="{Binding ZoomText}" Width="48" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (+, or Ctrl+wheel)" MinWidth="28" />
                </StackPanel>
                <ToggleButton Content="1:1" IsChecked="{Binding IsActualSize}" Focusable="False" Padding="12,3" FontWeight="SemiBold"
                              ToolTip="Both photos at actual size, zoomed and scrolled together. Drag to move around." />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Content="◀" Command="{Binding PreviousGroupCommand}" ToolTip="Previous group (Page Up)" />
                <TextBlock Text="{Binding GroupPosition}" VerticalAlignment="Center" Margin="8,0" />
                <Button Content="▶" Command="{Binding NextGroupCommand}" ToolTip="Next group (Page Down)" />

                <Button Content="◀" Command="{Binding PreviousPhotoCommand}" ToolTip="Previous photo (←)" Margin="24,0,0,0" />
                <TextBlock Text="{Binding PhotoPosition}" VerticalAlignment="Center" Margin="8,0" />
                <Button Content="▶" Command="{Binding NextPhotoCommand}" ToolTip="Next photo (→)" />
            </StackPanel>
        </DockPanel>

        <!-- The results page is moving or re-grouping: say why selecting is paused -->
        <Border DockPanel.Dock="Top" Background="#EEF4FB" Padding="10,4" Margin="0,0,0,8" CornerRadius="4"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding BusyText}" />
        </Border>

        <!-- Verdict, key help, close -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" Padding="16,4" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="← → other photos in the group · Page Up / Page Down groups · Space select or keep the right photo · Esc close" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding Left}" ContentTemplate="{StaticResource PaneTemplate}" Focusable="False" />
            <ContentControl Grid.Column="2" Content="{Binding Right}" ContentTemplate="{StaticResource PaneTemplate}" Focusable="False" />

            <ItemsControl Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Focusable="False"
                          ItemsSource="{Binding Details}" ItemTemplate="{StaticResource LeftDetail}" />
            <ItemsControl Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Focusable="False"
                          ItemsSource="{Binding Details}" ItemTemplate="{StaticResource RightDetail}" />
        </Grid>
    </DockPanel>
</Window>
