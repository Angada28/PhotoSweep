<UserControl x:Class="PhotoSweep.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PhotoSweep.Desktop.Behaviors">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectedBrush" Color="#C62828" />
        <SolidColorBrush x:Key="SelectedBackground" Color="#FFF3F3" />
        <SolidColorBrush x:Key="KeeperBrush" Color="#B8860B" />

        <!-- A photo tile: the whole tile is the button, so a click anywhere toggles it. -->
        <Style x:Key="PhotoTile" TargetType="Button">
            <Setter Property="Width" Value="176" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ToolTip" Value="{Binding Hint}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#999999" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
                    <Setter Property="Background" Value="{StaticResource SelectedBackground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Margin" Value="8" />
        </Style>

        <!-- The in-page panels above the summary bar: report, confirmation, leave reminder, undo. -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!--
            A photo tile. Clicking it (or Space) selects it. Compare opens three ways that never change the selection:
            the small Compare button (shown on hover and while the tile has keyboard focus), right-click > Compare, and
            Enter on a focused tile. The Compare button is the tile's sibling, not its child, so it still works when the
            tile is disabled (the last photo left unselected), and the menu is on the Grid for the same reason: a disabled
            button passes its mouse input to its parent.
        -->
        <DataTemplate x:Key="PhotoTemplate">
            <Grid x:Name="Tile" Margin="0,8,8,0" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Compare" Command="{Binding CompareCommand}" InputGestureText="Enter" />
                    </ContextMenu>
                </Grid.ContextMenu>
            <Button Style="{StaticResource PhotoTile}" Command="{Binding ToggleCommand}">
                <!-- A Button clicks on Enter; this binding runs first and handles the key, so Enter compares instead. -->
                <Button.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CompareCommand}" />
                </Button.InputBindings>
                <StackPanel>
                    <Grid Width="158" Height="158" Background="#F0F0F0">
                        <Image behaviors:ThumbnailLoader.Photo="{Binding}" behaviors:ThumbnailLoader.Size="158"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                        <StackPanel VerticalAlignment="Center"
                                    Visibility="{Binding ShowCloudPlaceholder, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36"
                                       HorizontalAlignment="Center" Foreground="#4A7FC1" />
                            <TextBlock Style="{StaticResource Placeholder}" Margin="8,4,8,0"
                                       Text="Only in the cloud. Not downloaded for a preview." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Placeholder}" Text="File not found"
                                   Visibility="{Binding ShowUnavailablePlaceholder, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Placeholder}" Text="No preview"
                                   Visibility="{Binding ShowNoPreviewPlaceholder, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="{StaticResource KeeperBrush}" CornerRadius="3" Padding="6,1"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                Visibility="{Binding IsKeeper, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="★ Keep" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{StaticResource SelectedBrush}" CornerRadius="3" Padding="6,1"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="✓ Move" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding File.Path}" />
                    <TextBlock Text="{Binding Folder}" Style="{StaticResource Detail}" ToolTip="{Binding Folder}" />
                    <TextBlock Style="{StaticResource Detail}">
                        <Run Text="{Binding Resolution, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Date}" Style="{StaticResource Detail}" />
                    <TextBlock Text="{Binding MatchText}" Style="{StaticResource Detail}" />
                </StackPanel>
            </Button>
                <!-- Transparent rather than collapsed, so Tab still reaches it (and focusing it shows it). -->
                <Button x:Name="CompareButton" Content="Compare" Command="{Binding CompareCommand}" Opacity="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,138,13,0" Padding="8,1"
                        ToolTip="Compare side by side, bigger (Enter)" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CompareButton" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="CompareButton" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,16,24,0">
        <!-- Header: title, totals, strictness -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                <TextBlock Text="Strictness" Foreground="Gray" Margin="0,0,0,2" />
                <ComboBox Width="220" ItemsSource="{Binding Strictness}" SelectedItem="{Binding SelectedStrictness}"
                          IsEnabled="{Binding CanChangeStrictness}"
                          DisplayMemberPath="Title" ToolTip="Re-groups the photos already scanned. Nothing is scanned again." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Results" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0">
                    <Run Text="{Binding Summary, Mode=OneWay}" FontSize="15" />
                    <Run Text="   " />
                    <Run Text="{Binding SpaceText, Mode=OneWay}" Foreground="Gray" />
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- What the scan couldn't include -->
        <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="10,6" Background="#FFF8E1" CornerRadius="4"
                Visibility="{Binding HasNotIncluded, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding CloudSkippedText}"
                           Visibility="{Binding HasCloudSkipped, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasUnreadableFolders, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="These folders couldn't be read and were skipped:" Foreground="DarkRed" />
                    <ItemsControl ItemsSource="{Binding UnreadableFolders}" Margin="12,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Bottom area, top to bottom: report, confirmation, leave reminder, undo bar, summary bar. All in-page panels
            bound to view-model state (no dialogs), so the whole flow is driven and tested through the view-model.
        -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <!-- Outcome of the last move, undo or failed check -->
            <Border Style="{StaticResource Panel}" Background="#FFF8E1" BorderBrush="#F0D890"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Dismiss" Command="{Binding DismissReportCommand}" Padding="10,2" />
                    <StackPanel>
                        <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding ReportSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                                        <!-- A long list scrolls instead of pushing the groups off the page. -->
                                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Lines}" Margin="12,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#555555" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- "Move N photos...?" -->
            <Border Style="{StaticResource Panel}" Background="#EEF4FB" BorderBrush="#B7CDE8"
                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Cancel" Command="{Binding CancelMoveCommand}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="Move" Command="{Binding ConfirmMoveCommand}" Padding="16,4" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding ConfirmText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConfirmFoldersHeading}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ConfirmFolders}" Margin="12,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Back with batches still undoable -->
            <Border Style="{StaticResource Panel}" Background="#FFF8E1" BorderBrush="#F0D890"
                    Visibility="{Binding IsConfirmingLeave, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Stay" Command="{Binding StayCommand}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="Leave page" Command="{Binding LeaveCommand}" Padding="12,4" />
                    </StackPanel>
                    <TextBlock Text="{Binding LeaveText}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Undo bar for the latest batch -->
            <Border Style="{StaticResource Panel}" Background="#EDF7ED" BorderBrush="#B5DBB5"
                    Visibility="{Binding HasUndo, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Open review folder" Command="{Binding OpenReviewFolderCommand}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="Undo" Command="{Binding UndoCommand}" Padding="16,4" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding UndoText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EarlierBatchesText}" Foreground="#555555" />
                        <TextBlock Text="{Binding UndoNote}" Foreground="#555555" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DeleteNote}" Foreground="#555555" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Summary bar -->
            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Back" Command="{Binding BackCommand}" Padding="16,4" Margin="0,0,16,0" />
                    <Button DockPanel.Dock="Right" Content="Move to review folder&#x2026;" Command="{Binding MoveCommand}" Padding="16,4" Margin="8,0,0,0"
                            FontWeight="SemiBold" ToolTip="Moves the selected photos into a _PhotoSweep Removed folder. Nothing is deleted." />
                    <Button DockPanel.Dock="Right" Content="Clear selection" Command="{Binding ClearSelectionCommand}" Padding="12,4" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Select all suggested" Command="{Binding SelectSuggestedCommand}" Padding="12,4" />
                    <TextBlock Text="{Binding SelectionText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <!--
                One row per group. Virtualized with recycling: only the rows on screen (plus a little either side)
                exist as controls, and scrolled-off rows are reused for the ones coming into view. CanContentScroll
                must be true or the ScrollViewer measures every row and virtualization switches off.
            -->
            <ItemsControl ItemsSource="{Binding Groups}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="12,8,12,12" BorderBrush="#E3E3E3" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Compare" Command="{Binding CompareCommand}" Padding="10,1" Margin="12,0,0,0"
                                            ToolTip="Compare this group's photos side by side, bigger" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="★" Foreground="{StaticResource KeeperBrush}" />
                                        <Run Text="{Binding KeeperReason, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <!-- Groups are small, so the tiles inside a row aren't virtualized; big groups wrap. -->
                                <ItemsControl ItemsSource="{Binding Photos}" ItemTemplate="{StaticResource PhotoTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding EmptyText}" FontSize="15" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!-- Covers the groups while re-grouping, moving or undoing, so photos can't be clicked mid-change. -->
            <Border Background="#CCFFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                    <TextBlock Text="{Binding BusyText}" FontSize="15" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
