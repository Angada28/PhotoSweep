<UserControl x:Class="PhotoSweep.Desktop.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:PhotoSweep.Desktop.Behaviors"
             behaviors:FolderDrop.Command="{Binding DropFoldersCommand}"
             Background="Transparent">
    <!-- Transparent (not null) background so the whole page, including empty space, receives drops. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Find duplicate photos" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Choose the folders to scan, or drag folders onto this window." Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ListBox ItemsSource="{Binding Folders}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Remove" Padding="6,0"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No folders chosen yet" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Folders.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <WrapPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="12,4" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="Add folder…" Command="{Binding AddFolderCommand}" />
            <Button Content="Pictures" Command="{Binding AddPicturesCommand}" />
            <Button Content="OneDrive" Command="{Binding AddOneDriveCommand}"
                    Visibility="{Binding HasOneDrive, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <TextBlock Text="How alike must photos be?" FontWeight="SemiBold" Margin="0,0,0,4" />
            <!-- A ListBox gives single selection bound to SelectedStrictness; each item is drawn as a radio button. -->
            <ListBox ItemsSource="{Binding Strictness}" SelectedItem="{Binding SelectedStrictness}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <RadioButton IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Margin="0,4" Focusable="False">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Description}" Foreground="Gray" FontSize="12" />
                                        </StackPanel>
                                    </RadioButton>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>

        <Button Grid.Row="4" Content="Scan" Command="{Binding ScanCommand}" IsDefault="True"
                HorizontalAlignment="Right" Padding="32,6" Margin="0,16,0,0" FontWeight="SemiBold" />
    </Grid>
</UserControl>
