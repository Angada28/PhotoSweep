<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF views (XAML) and Windows implementations of the Presentation service interfaces. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhotoSweep</AssemblyName>
    <!-- The exe's icon in Explorer and the taskbar. Generated by tools/GenerateIcon.cs. -->
    <ApplicationIcon>Assets\PhotoSweep.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Release packaging, only when publishing for a platform (dotnet publish -r win-x64). Gives one PhotoSweep.exe that
    runs without .NET installed. Plain builds, dotnet run and the tests are unaffected.
    IncludeNativeLibrariesForSelfExtract: WPF's native DLLs (wpfgfx, PresentationNative, …) go inside the exe too,
    instead of next to it. No trimming: WPF doesn't support it.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not compressed: antivirus heuristics flag compressed self-extracting bundles more often. Costs size. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- No .pdb files next to the exe: none for this project, and none copied from Core and Presentation. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as a WPF resource so the windows can show it in their title bars (Icon="/Assets/PhotoSweep.ico"). -->
    <Resource Include="Assets\PhotoSweep.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoSweep.Presentation\PhotoSweep.Presentation.csproj" />
  </ItemGroup>

</Project>
