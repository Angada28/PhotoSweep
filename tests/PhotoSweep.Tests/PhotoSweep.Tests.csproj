<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests Core and Presentation only. Plain net10.0, so tests never load WPF. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed test photos (see TestData/Photos/README.md), copied next to the test DLL. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotoSweep.Core\PhotoSweep.Core.csproj" />
    <ProjectReference Include="..\..\src\PhotoSweep.Presentation\PhotoSweep.Presentation.csproj" />
    <ProjectReference Include="..\..\tools\PhotoSweep.Eval\PhotoSweep.Eval.csproj" />
  </ItemGroup>

</Project>
